SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_clave_secreta_aqui
PDF_IMPORT_USER_ID=tu_user_id_de_auth
WATCH_PATH=./inbox

# Direct Postgres connection (URI) — NO el service role key. Se usa solo para
# aplicar migraciones de esquema (ej. picking_lists.source_order_date) al hacer
# "⟳ Update app". Cópiala de Supabase → Project Settings → Database → Connection
# string (URI). Si la dejas vacía, el paso de migraciones se omite sin error.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.tu-proyecto.supabase.co:5432/postgres

# ── Tiempos de la captura AS400 (docs/capture-speed-plan.md) ─────────────────
# Los valores de abajo son los que el código traía fijos: ponerlos aquí no
# cambia nada por sí solo. Existen para poder ajustar la captura en la MacBook
# de Bay 2 con un edit + reinicio, en vez de un despliegue — y para revertir una
# fase del plan de velocidad en 30 segundos si algo va mal.
#
# AS400_PAGE_WAIT=0.8          # espera tras F6, tras teclear el número y tras cada ENTER
# AS400_POLL_INTERVAL=0.3      # entre relecturas mientras la pantalla no ha refrescado
# AS400_REFRESH_TIMEOUT=5.0    # cuánto se espera a que la pantalla avance
# AS400_OSASCRIPT_TIMEOUT=10   # un osascript colgado bloquea el scanner entero
# AS400_REUSE_HEADER=1         # 0 = volver a buscar la orden aunque ya esté en pantalla
# AS400_FOCUS_SETTLE=0.4       # espera tras traer Mocha al frente (sólo si no lo estaba)
# AS400_SELECT_DELAY=0.15      # entre Cmd+A y Cmd+C
# AS400_COPY_DELAY=0.0         # ya no se duerme tras Cmd+C: se sondea el portapapeles
# AS400_CLIP_TIMEOUT=1.0       # cuánto se espera a que la copia llegue al portapapeles
# AS400_CLIP_POLL=0.02         # cada cuánto se pregunta
# AS400_READ_IN_SCRIPT=0       # 1 = hacer la lectura entera dentro de un solo osascript
#                              #     (centinela, teclas, espera y el texto de vuelta).
#                              #     En Bay 2 un proceso cuesta ~0,5 s: sondear con
#                              #     pbpaste costaba ~0,4 s de los 1,09 s de una lectura.
# AS400_WAIT_FOR_SETTLED=0     # 1 = esperar a que la pantalla cambie Y quede quieta,
#                              #     en vez de dormir un tiempo fijo (fase F4). Apagada
#                              #     por defecto: es la que cambia CUÁNDO nos fiamos.
# AS400_SETTLED_READS=2        # lecturas idénticas seguidas antes de fiarse de una página.
#                              #     1 es una lectura más rápida por página y PUEDE coger
#                              #     una página a medio pintar — ver el plan antes de bajarlo.
# AS400_SETTLE_POLL=0.0        # pausa extra entre esas lecturas (la lectura ya es el intervalo)
# AS400_REFRESH_DEADLINE=25    # segundos de reloj esperando a que la pantalla avance (F4)
# SCAN_FOUND_DELAY_SEC=5       # pausa entre dos órdenes encontradas; 1 si la Mac está libre
# AS400_SINGLE_SCRIPT=1        # 0 = leer la pantalla como antes (3 procesos y 3 sleeps).
#                              #     Es el interruptor de vuelta atrás de F2/F3 y la forma
#                              #     de medir el ANTES en Bay 2: todo vive en main, así que
#                              #     un update trae todas las fases de golpe.

# ── Catálogo de bicis desde AS400 (docs/sku-catalog-enrichment.md) ───────────
# Se leen en tiempo de llamada: cambiarlas es editar este archivo y reiniciar el
# LaunchAgent, NO un viaje a Bay 2.
# SKU_ENRICH=0                 # 1 = usar los huecos del escáner para el catálogo.
#                              # Nace apagado a propósito: el deploy que trae esto
#                              # trae también los 3 intentos de F6·F6·F7, y un
#                              # deploy no debe empezar a manejar el terminal solo.
# SKU_ENRICH_WRITE=0           # F3. Con 0 (F2) el paso lee, loguea lo que
#                              # escribiría, y no toca la base de datos.
# SKU_ENRICH_WEIGHT=0          # F4, el peso. Desde el 8 sep la cola recorre TODAS
#                              # las bicis, así que cada lectura trae también un
#                              # peso: sin este interruptor la fase del nombre y
#                              # la del peso se desplegarían como una sola.
# SKU_ENRICH_GAP_BUDGET_SEC=300  # cuánto se trabaja el catálogo antes de volver
#                              # a preguntar por órdenes. Desde el 8 sep este
#                              # trabajo SUSTITUYE al sueño de 20 min: se trabaja
#                              # X, se pregunta por órdenes, y si no hay se sigue
#                              # trabajando. Subirlo = menos consultas de orden;
#                              # bajarlo = órdenes descubiertas antes.
#                              # Es reloj, no cuenta: una consulta lenta acorta la
#                              # ráfaga, no la alarga.
# SCAN_MIN_WORK_TO_SKIP_WAIT_SEC=20  # trabajo mínimo para dar el sueño por
#                              # cumplido. Por debajo no había nada que hacer y se
#                              # vuelve al sueño largo: si no, se le preguntaría al
#                              # AS400 por la misma orden que falta cada segundos.
# SKU_ENRICH_MAX_PER_GAP=40    # tope duro de consultas por hueco. Manda el primero
#                              # de los dos límites que se alcance. Poner 1 devuelve
#                              # la cadencia vieja de un SKU por hueco, sin deploy.
# SKU_ENRICH_FETCH_LIMIT=200   # filas de catálogo que se traen para elegir una.
# SKU_UNKNOWN_PATH=            # dónde se anotan los SKUs que AS400 no conoce
#                              # (default: .sku_unknown.json junto al código).
# AS400_UNSTICK_TRIES=3        # intentos de F6·F6·F7 antes de rendirse ante un
#                              # atascamiento. Afecta también al arranque de sesión.
#
# ── Salir del callejón sin salida (ADDITIONAL MESSAGE INFORMATION) ───────────
# Esa pantalla no responde a NINGUNA tecla, así que el daemon se queda muerto
# hasta que una persona reabre la sesión (36 min el 8 sep 2026; un fin de semana
# entero si pasa un viernes por la tarde).
# La salida es **Cmd+N**: una ventana de sesión nueva. Funciona porque es un
# comando de la APLICACIÓN, no una tecla del 5250 — la pantalla muerta no manda
# sobre los menús de Mocha.
# Después, como limpieza: Ctrl+Shift+Tab a la ventana muerta y Cmd+W + ENTER
# (el Cmd+W sólo PREGUNTA; el Enter es el que cierra — Rafael, 8 sep). Se abre
# antes de cerrar a propósito: así siempre hay dos ventanas y el Cmd+W nunca
# puede ser el que cierre Mocha entero. Y antes de cerrar se LEE la pantalla:
# si no es la del callejón, no se cierra nada.
# AS400_HARD_RESTART=0             # 1 = que se rescate solo con Cmd+N. Nace
#                                  # apagado para que la primera vez haya alguien
#                                  # delante mirando, no porque sea arriesgado.
# AS400_HARD_RESTART_IDLE_SEC=300  # Mac sin tocar. La ventana nueva roba el foco,
#                                  # y robarlo a media orden interrumpe a alguien.
# AS400_HARD_RESTART_COOLDOWN_SEC=1800  # un terminal irrecuperable no se toca cada
#                                  # cinco minutos toda la noche.
# AS400_CLOSE_WINDOW_WAIT=1.5      # espera tras cerrar la ventana muerta
# AS400_CLOSE_CONFIRM_DELAY=0.15   # entre el Cmd+W y el Enter que lo confirma.
#                                  # Van dentro del MISMO osascript: un diálogo
#                                  # sin contestar bloquea todos los Apple events.
# AS400_WINDOW_SWITCH_WAIT=1       # espera tras Ctrl+Shift+Tab / Ctrl+Tab
# AS400_NEW_WINDOW_WAIT=3          # espera tras el Cmd+N
# AS400_HARD_RESTART_QUIT=0        # último recurso de verdad: cerrar Mocha entero
#                                  # y reabrirlo, sólo si Cmd+N falla. Apagado:
#                                  # cerrar puede sacar un diálogo (y un diálogo
#                                  # bloquea TODOS los Apple events posteriores) y
#                                  # supone que Mocha reconecta solo al abrirse.
# AS400_QUIT_GRACE=8               # espera al quit amable antes de mandar TERM
# AS400_RESTART_PAUSE=3            # entre cerrar y volver a abrir
# SCAN_UNAVAILABLE_LOUD_SEC=600    # tras esto, un AS400 inalcanzable se loguea como
#                                  # ERROR una vez, no como info cada 5 min.

# ── Un push es el deploy ─────────────────────────────────────────────────────
# Bay 2 mira `origin` cada pocos minutos y, cuando es SEGURO, corre el mismo
# scripts/update.sh que el botón ⟳. Pregunta esta máquina, no llama GitHub.
# COSTE MEDIDO: 0.26 s por sondeo (casi todo espera de red, no CPU), 288 veces al
# día = menos de una décima de porcentaje de la máquina, y menos que dos capturas
# del AS400. Usa `ls-remote`, que NO escribe nada en el repo.
# Que avisara GitHub costaría MÁS en esta Mac, no menos: exige o exponerla a
# internet o un demonio con conexión permanente (cloudflared, o un runner
# self-hosted de Actions, que es un long-poll disfrazado de servicio).
# NO actualiza durante una captura (update.sh reinicia los LaunchAgents y dejaría
# a Mocha en una pantalla desconocida), ni mientras alguien usa el Mac, ni con
# cambios sin commitear (el pull es --ff-only y fallaría igual).
# AUTO_UPDATE=1                # 0 = desactivar y volver al botón ⟳ a mano
# AUTO_UPDATE_POLL_SEC=300     # cada cuánto se mira origin (mínimo 60)
# AUTO_UPDATE_RETRY_SEC=20     # si la actualización está lista pero el terminal
#                              # ocupado: el trabajo de catálogo ya se apartó y
#                              # libera en segundos; esperar 5 min desperdiciaría
#                              # la ventana que acabamos de abrir.
# AUTO_UPDATE_IDLE_SEC=60      # inactividad mínima antes de reiniciar la app
# AUTO_UPDATE_BRANCH=          # por defecto, la rama que esté puesta
